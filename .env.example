# Anthropic API key for the /api/chat endpoint (Netlify function + Vite dev middleware)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Resend API key for the /api/contact and /api/blitz endpoints
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_...

# Sender address — must be on a domain verified in your Resend dashboard.
# Format can be `name@domain` or `"Name <name@domain>"`.
MAIL_FROM=Prima Vista Bauprojekte <noreply@primavista-bauprojekte.com>

# Where form submissions are delivered.
MAIL_TO_OFFICE=office@primavista-bauprojekte.com

# MongoDB Atlas M0 connection for the blog/admin system.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=prima_vista

# JWT secret for the admin httpOnly cookie.
JWT_SECRET=replace-with-a-long-random-string

# Used only by `npm run seed:admin`; do not commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional Google admin login. The client id is served to the browser at
# runtime via /api/auth/session, so no VITE_ build-time var is needed — just
# set these two and the "Mit Google anmelden" button appears automatically.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ADMIN_GOOGLE_EMAIL=admin@example.com

# Optional Google reviews integration. Without these, the homepage uses the
# local fallback testimonial.
GOOGLE_PLACES_API_KEY=...
GOOGLE_PLACE_ID=...

# Optional Google Analytics 4 measurement ID. Analytics is only loaded after
# the visitor accepts optional services in the cookie banner.
VITE_GOOGLE_ANALYTICS_ID=G-ZSYN2EKHTF

# --- Google Calendar (Kontakt-Formular Wunschtermin) ---
# Service account with the office calendar shared to it ("Make changes to
# events"). GOOGLE_SA_KEY is the private_key from the service-account JSON
# (keep the \n escapes or paste the multiline key). All three unset = the
# date/time picker uses fallback slots without live conflict detection. When
# configured, exact two-hour slots are derived from Google Calendar free/busy.
GOOGLE_CALENDAR_ID=primavista.bauprojekte@gmail.com
GOOGLE_SA_EMAIL=website-calendar@your-project.iam.gserviceaccount.com
GOOGLE_SA_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Instagram feed (homepage section) ---
# Long-lived token for the Instagram API with Instagram Login. The account must
# be a Professional (Business or Creator) account. Unset = the homepage section
# is hidden entirely. See docs/INSTAGRAM_SETUP.md for how to obtain this.
#
# This value only SEEDS the token chain: the daily scheduled function exchanges
# it for a fresh 60-day token and stores the result in Netlify Blobs, so the
# variable does not need updating again. Paste a new one here only if the feed
# ever lapses.
INSTAGRAM_ACCESS_TOKEN=IGAA...
# Optional. Defaults to the handle reported by the API, else primavista.bauprojekte.
INSTAGRAM_USERNAME=primavista.bauprojekte
# Optional. Number of posts to show (default 12, max 24).
INSTAGRAM_POST_LIMIT=12
# Optional. Graph API version override (default v26.0).
# INSTAGRAM_API_VERSION=v26.0

# Dev only: log outgoing mail instead of sending via Resend.
# MAIL_DRY_RUN=1
